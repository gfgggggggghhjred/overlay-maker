{
  "name": "cudi-overlay-studio",
  "version": "0.22.0",
  "description": "Offline controller overlay production studio with universal standard-gamepad input",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win zip --x64",
    "check": "node tools/check.cjs",
    "test": "node tools/test.cjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "@playwright/test": "^1.56.0"
  },
  "build": {
    "appId": "local.cudi.overlaystudio",
    "productName": "Overlay Studio",
    "files": [
      "main.cjs",
      "github-delivery.cjs",
      "customer-preview.cjs",
      "app/**/*"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "Overlay-Studio-Windows-x64.${ext}",
    "extraFiles": [
      {
        "from": "START-HERE.txt",
        "to": "START-HERE.txt"
      }
    ]
  }
}
